<?xml version="1.0" encoding="UTF-8"?>
<!-- Slate rounded translucent frame. Tiles: frame at 0,0; mask at 60,0; shadow at 0,50; hints at 110,0. -->
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="200" height="110" viewBox="0 0 200 110">
  <defs>
    <path id="shape" d="M 0,{{radius_popover|px}} A {{radius_popover|px}},{{radius_popover|px}} 0 0 1 {{radius_popover|px}},0 H 16 V 16 H 0 Z"/>
    <path id="edge" transform="translate(.5 .5)" d="M 0,15.5 V {{radius_popover|px}} A {{radius_popover|px}},{{radius_popover|px}} 0 0 1 {{radius_popover|px}},0 H 15.5"/>
    <g id="corner">
      <use xlink:href="#shape" fill="{{popover_bg}}" fill-opacity=".78"/>
      <use xlink:href="#edge" fill="none" stroke="rgb({{border|rgb}})" stroke-opacity=".14"/>
    </g>
    <linearGradient id="gt" gradientUnits="userSpaceOnUse" x1="0" y1="22" x2="0" y2="0"><stop offset="0" stop-opacity=".4"/><stop offset=".2" stop-opacity=".29"/><stop offset=".4" stop-opacity=".17"/><stop offset=".6" stop-opacity=".08"/><stop offset=".8" stop-opacity=".03"/><stop offset="1" stop-opacity="0"/></linearGradient>
    <linearGradient id="gb" gradientUnits="userSpaceOnUse" x1="0" y1="8" x2="0" y2="30"><stop offset="0" stop-opacity=".4"/><stop offset=".2" stop-opacity=".29"/><stop offset=".4" stop-opacity=".17"/><stop offset=".6" stop-opacity=".08"/><stop offset=".8" stop-opacity=".03"/><stop offset="1" stop-opacity="0"/></linearGradient>
    <linearGradient id="gl" gradientUnits="userSpaceOnUse" x1="22" y1="0" x2="0" y2="0"><stop offset="0" stop-opacity=".4"/><stop offset=".2" stop-opacity=".29"/><stop offset=".4" stop-opacity=".17"/><stop offset=".6" stop-opacity=".08"/><stop offset=".8" stop-opacity=".03"/><stop offset="1" stop-opacity="0"/></linearGradient>
    <linearGradient id="gr" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="22" y2="0"><stop offset="0" stop-opacity=".4"/><stop offset=".2" stop-opacity=".29"/><stop offset=".4" stop-opacity=".17"/><stop offset=".6" stop-opacity=".08"/><stop offset=".8" stop-opacity=".03"/><stop offset="1" stop-opacity="0"/></linearGradient>
    <radialGradient id="gct" gradientUnits="userSpaceOnUse" cx="22" cy="22" r="22"><stop offset="0" stop-opacity=".4"/><stop offset=".2" stop-opacity=".29"/><stop offset=".4" stop-opacity=".17"/><stop offset=".6" stop-opacity=".08"/><stop offset=".8" stop-opacity=".03"/><stop offset="1" stop-opacity="0"/></radialGradient>
    <radialGradient id="gcb" gradientUnits="userSpaceOnUse" cx="0" cy="8" r="22"><stop offset="0" stop-opacity=".4"/><stop offset=".2" stop-opacity=".29"/><stop offset=".4" stop-opacity=".17"/><stop offset=".6" stop-opacity=".08"/><stop offset=".8" stop-opacity=".03"/><stop offset="1" stop-opacity="0"/></radialGradient>
  </defs>

  <g id="topleft"><use xlink:href="#corner"/></g>
  <g id="topright" transform="matrix(-1 0 0 1 40 0)"><use xlink:href="#corner"/></g>
  <g id="bottomleft" transform="matrix(1 0 0 -1 0 40)"><use xlink:href="#corner"/></g>
  <g id="bottomright" transform="matrix(-1 0 0 -1 40 40)"><use xlink:href="#corner"/></g>
  <g id="top" transform="translate(20 0)"><rect width="1" height="16" fill="{{popover_bg}}" fill-opacity=".78"/><rect width="1" height="1" fill="rgb({{border|rgb}})" fill-opacity=".14"/></g>
  <g id="bottom" transform="translate(20 24)"><rect width="1" height="16" fill="{{popover_bg}}" fill-opacity=".78"/><rect y="15" width="1" height="1" fill="rgb({{border|rgb}})" fill-opacity=".14"/></g>
  <g id="left" transform="translate(0 20)"><rect width="16" height="1" fill="{{popover_bg}}" fill-opacity=".78"/><rect width="1" height="1" fill="rgb({{border|rgb}})" fill-opacity=".14"/></g>
  <g id="right" transform="translate(24 20)"><rect width="16" height="1" fill="{{popover_bg}}" fill-opacity=".78"/><rect x="15" width="1" height="1" fill="rgb({{border|rgb}})" fill-opacity=".14"/></g>
  <rect id="center" x="20" y="20" width="1" height="1" fill="{{popover_bg}}" fill-opacity=".78"/>

  <g id="mask-topleft" transform="translate(60 0)"><use xlink:href="#shape"/></g>
  <g id="mask-topright" transform="matrix(-1 0 0 1 100 0)"><use xlink:href="#shape"/></g>
  <g id="mask-bottomleft" transform="matrix(1 0 0 -1 60 40)"><use xlink:href="#shape"/></g>
  <g id="mask-bottomright" transform="matrix(-1 0 0 -1 100 40)"><use xlink:href="#shape"/></g>
  <rect id="mask-top" x="80" y="0" width="1" height="16"/>
  <rect id="mask-bottom" x="80" y="24" width="1" height="16"/>
  <rect id="mask-left" x="60" y="20" width="16" height="1"/>
  <rect id="mask-right" x="84" y="20" width="16" height="1"/>
  <rect id="mask-center" x="80" y="20" width="1" height="1"/>

  <g id="shadow-topleft" transform="translate(0 50)"><rect width="22" height="14" fill="url(#gct)"/></g>
  <g id="shadow-topright" transform="matrix(-1 0 0 1 56 50)"><rect width="22" height="14" fill="url(#gct)"/></g>
  <g id="shadow-bottomleft" transform="matrix(-1 0 0 1 22 74)"><rect width="22" height="30" fill="url(#gcb)"/></g>
  <g id="shadow-bottomright" transform="translate(34 74)"><rect width="22" height="30" fill="url(#gcb)"/></g>
  <g id="shadow-top" transform="translate(30 50)"><rect width="1" height="14" fill="url(#gt)"/></g>
  <g id="shadow-bottom" transform="translate(30 74)"><rect width="1" height="30" fill="url(#gb)"/></g>
  <g id="shadow-left" transform="translate(0 70)"><rect width="22" height="1" fill="url(#gl)"/></g>
  <g id="shadow-right" transform="translate(34 70)"><rect width="22" height="1" fill="url(#gr)"/></g>
  <rect id="shadow-center" x="30" y="70" width="1" height="1" fill-opacity="0"/>

  <rect id="hint-top-margin" x="110" y="0" width="4" height="{{spacing_s|px}}" fill-opacity="0"/>
  <rect id="hint-bottom-margin" x="120" y="0" width="4" height="{{spacing_s|px}}" fill-opacity="0"/>
  <rect id="hint-left-margin" x="110" y="30" width="{{spacing_s|px}}" height="4" fill-opacity="0"/>
  <rect id="hint-right-margin" x="110" y="40" width="{{spacing_s|px}}" height="4" fill-opacity="0"/>
  <rect id="shadow-hint-top-margin" x="140" y="0" width="4" height="14" fill-opacity="0"/>
  <rect id="shadow-hint-bottom-margin" x="150" y="0" width="4" height="30" fill-opacity="0"/>
  <rect id="shadow-hint-left-margin" x="140" y="40" width="22" height="4" fill-opacity="0"/>
  <rect id="shadow-hint-right-margin" x="140" y="50" width="22" height="4" fill-opacity="0"/>
</svg>
