<?xml version="1.0" encoding="UTF-8"?>
<!--
  Slate Aurorae decoration. Frame layout (px), must match __NAME__rc:
    padding L/R 36, top 24, bottom 48 (shadow area), title bar {{headerbar_height}}, borders 0.
  Corner pieces are 12 px wider than the side padding so the {{radius_window}} top corners fit; the
  extra 12 px hide under the client.
  Shadow = blurred, rounded rect drawn with gradients: the same gaussian profile on the four
  strips (linear) and the four corners (radial around the shadow rect's corner arc centre).
  Active: 0 12px 36px, peak alpha 0.36 (GTK window_shadow). Inactive: 0 6px 20px, peak 0.22.
  Alpha is literal (tokens cannot carry the dark/light pair); the hairline follows {{border}}.
  The elements at x 120.. are the inactive window (decoration-inactive-*).
-->
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="232" height="180" viewBox="0 0 232 180">
  <defs>
    <!-- profiles, offset 0 = outer end, 1 = window edge (radial: 0 = arc centre) -->
    <linearGradient id="aSide"><stop offset="0" stop-opacity="0.008"/><stop offset="0.125" stop-opacity="0.014"/><stop offset="0.25" stop-opacity="0.024"/><stop offset="0.375" stop-opacity="0.038"/><stop offset="0.5" stop-opacity="0.057"/><stop offset="0.625" stop-opacity="0.082"/><stop offset="0.75" stop-opacity="0.111"/><stop offset="0.875" stop-opacity="0.144"/><stop offset="1" stop-opacity="0.180"/></linearGradient>
    <linearGradient id="aTop"><stop offset="0" stop-opacity="0.008"/><stop offset="0.125" stop-opacity="0.012"/><stop offset="0.25" stop-opacity="0.017"/><stop offset="0.375" stop-opacity="0.024"/><stop offset="0.5" stop-opacity="0.033"/><stop offset="0.625" stop-opacity="0.044"/><stop offset="0.75" stop-opacity="0.057"/><stop offset="0.875" stop-opacity="0.073"/><stop offset="1" stop-opacity="0.091"/></linearGradient>
    <linearGradient id="aBot"><stop offset="0" stop-opacity="0.008"/><stop offset="0.125" stop-opacity="0.017"/><stop offset="0.25" stop-opacity="0.033"/><stop offset="0.375" stop-opacity="0.057"/><stop offset="0.5" stop-opacity="0.091"/><stop offset="0.625" stop-opacity="0.133"/><stop offset="0.75" stop-opacity="0.180"/><stop offset="0.875" stop-opacity="0.227"/><stop offset="1" stop-opacity="0.269"/></linearGradient>
    <linearGradient id="aRad"><stop offset="0" stop-opacity="0.269"/><stop offset="0.125" stop-opacity="0.227"/><stop offset="0.25" stop-opacity="0.180"/><stop offset="0.375" stop-opacity="0.133"/><stop offset="0.5" stop-opacity="0.091"/><stop offset="0.625" stop-opacity="0.057"/><stop offset="0.75" stop-opacity="0.033"/><stop offset="0.875" stop-opacity="0.017"/><stop offset="1" stop-opacity="0.008"/></linearGradient>
    <linearGradient id="iSide"><stop offset="0" stop-opacity="0"/><stop offset="0.125" stop-opacity="0"/><stop offset="0.25" stop-opacity="0.001"/><stop offset="0.375" stop-opacity="0.003"/><stop offset="0.5" stop-opacity="0.008"/><stop offset="0.625" stop-opacity="0.019"/><stop offset="0.75" stop-opacity="0.040"/><stop offset="0.875" stop-opacity="0.072"/><stop offset="1" stop-opacity="0.110"/></linearGradient>
    <linearGradient id="iTop"><stop offset="0" stop-opacity="0"/><stop offset="0.125" stop-opacity="0.001"/><stop offset="0.25" stop-opacity="0.002"/><stop offset="0.375" stop-opacity="0.004"/><stop offset="0.5" stop-opacity="0.008"/><stop offset="0.625" stop-opacity="0.015"/><stop offset="0.75" stop-opacity="0.025"/><stop offset="0.875" stop-opacity="0.040"/><stop offset="1" stop-opacity="0.060"/></linearGradient>
    <linearGradient id="iBot"><stop offset="0" stop-opacity="0"/><stop offset="0.125" stop-opacity="0"/><stop offset="0.25" stop-opacity="0"/><stop offset="0.375" stop-opacity="0.002"/><stop offset="0.5" stop-opacity="0.008"/><stop offset="0.625" stop-opacity="0.025"/><stop offset="0.75" stop-opacity="0.060"/><stop offset="0.875" stop-opacity="0.110"/><stop offset="1" stop-opacity="0.160"/></linearGradient>
    <linearGradient id="iRad"><stop offset="0" stop-opacity="0.195"/><stop offset="0.125" stop-opacity="0.160"/><stop offset="0.25" stop-opacity="0.110"/><stop offset="0.375" stop-opacity="0.060"/><stop offset="0.5" stop-opacity="0.025"/><stop offset="0.625" stop-opacity="0.008"/><stop offset="0.75" stop-opacity="0.002"/><stop offset="0.875" stop-opacity="0"/><stop offset="1" stop-opacity="0"/></linearGradient>

    <!-- strips: left, right, top, bottom -->
    <linearGradient id="aL" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="36" y2="0" xlink:href="#aSide"/>
    <linearGradient id="aR" gradientUnits="userSpaceOnUse" x1="112" y1="0" x2="76" y2="0" xlink:href="#aSide"/>
    <linearGradient id="aT" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="24" xlink:href="#aTop"/>
    <linearGradient id="aB" gradientUnits="userSpaceOnUse" x1="0" y1="126" x2="0" y2="78" xlink:href="#aBot"/>
    <linearGradient id="iL" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="36" y2="0" xlink:href="#iSide"/>
    <linearGradient id="iR" gradientUnits="userSpaceOnUse" x1="112" y1="0" x2="76" y2="0" xlink:href="#iSide"/>
    <linearGradient id="iT" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="24" xlink:href="#iTop"/>
    <linearGradient id="iB" gradientUnits="userSpaceOnUse" x1="0" y1="126" x2="0" y2="78" xlink:href="#iBot"/>
    <!-- corners: centre = arc centre of the shadow rect (window corner + 12, shifted by the y offset) -->
    <radialGradient id="aTL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(48 48) scale(48)" xlink:href="#aRad"/>
    <radialGradient id="aTR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(64 48) scale(48)" xlink:href="#aRad"/>
    <radialGradient id="aBL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(48 78) scale(48)" xlink:href="#aRad"/>
    <radialGradient id="aBR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(64 78) scale(48)" xlink:href="#aRad"/>
    <radialGradient id="iTL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(48 42) scale(48)" xlink:href="#iRad"/>
    <radialGradient id="iTR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(64 42) scale(48)" xlink:href="#iRad"/>
    <radialGradient id="iBL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(48 72) scale(48)" xlink:href="#iRad"/>
    <radialGradient id="iBR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(64 72) scale(48)" xlink:href="#iRad"/>
  </defs>

  <!-- ===== ACTIVE ===== -->
  <g id="decoration-topleft">
    <rect x="0" y="0" width="48" height="48" fill="url(#aTL)"/>
    <rect x="0" y="48" width="36" height="14" fill="url(#aL)"/>
    <path d="M36 62V36A12 12 0 0 1 48 24V62Z" fill="{{headerbar_bg}}"/>
    <path d="M35 62V36A13 13 0 0 1 48 23V24A12 12 0 0 0 36 36V62Z" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <g id="decoration-top">
    <rect x="48" y="0" width="16" height="24" fill="url(#aT)"/>
    <rect x="48" y="24" width="16" height="38" fill="{{headerbar_bg}}"/>
    <rect x="48" y="23" width="16" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <g id="decoration-topright">
    <rect x="64" y="0" width="48" height="48" fill="url(#aTR)"/>
    <rect x="76" y="48" width="36" height="14" fill="url(#aR)"/>
    <path d="M64 24A12 12 0 0 1 76 36V62H64Z" fill="{{headerbar_bg}}"/>
    <path d="M64 23V24A12 12 0 0 1 76 36V62H77V36A13 13 0 0 0 64 23Z" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <g id="decoration-left">
    <rect x="0" y="62" width="36" height="16" fill="url(#aL)"/>
    <rect x="36" y="62" width="12" height="16" fill="{{window_bg}}"/>
    <rect x="35" y="62" width="1" height="16" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <rect id="decoration-center" x="48" y="62" width="16" height="16" fill="{{window_bg}}"/>
  <g id="decoration-right">
    <rect x="64" y="62" width="12" height="16" fill="{{window_bg}}"/>
    <rect x="76" y="62" width="36" height="16" fill="url(#aR)"/>
    <rect x="76" y="62" width="1" height="16" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <g id="decoration-bottomleft">
    <rect x="0" y="78" width="48" height="48" fill="url(#aBL)"/>
    <rect x="35" y="78" width="13" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <g id="decoration-bottom">
    <rect x="48" y="78" width="16" height="48" fill="url(#aB)"/>
    <rect x="48" y="78" width="16" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <g id="decoration-bottomright">
    <rect x="64" y="78" width="48" height="48" fill="url(#aBR)"/>
    <rect x="64" y="78" width="13" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
  </g>
  <rect id="decoration-maximized-center" x="0" y="140" width="16" height="38" fill="{{headerbar_bg}}"/>

  <!-- ===== INACTIVE (shifted 120 px right) ===== -->
  <g transform="translate(120 0)">
    <g id="decoration-inactive-topleft">
      <rect x="0" y="0" width="48" height="42" fill="url(#iTL)"/>
      <rect x="0" y="42" width="36" height="20" fill="url(#iL)"/>
      <path d="M36 62V36A12 12 0 0 1 48 24V62Z" fill="{{headerbar_bg_backdrop}}"/>
      <path d="M35 62V36A13 13 0 0 1 48 23V24A12 12 0 0 0 36 36V62Z" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <g id="decoration-inactive-top">
      <rect x="48" y="0" width="16" height="24" fill="url(#iT)"/>
      <rect x="48" y="24" width="16" height="38" fill="{{headerbar_bg_backdrop}}"/>
      <rect x="48" y="23" width="16" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <g id="decoration-inactive-topright">
      <rect x="64" y="0" width="48" height="42" fill="url(#iTR)"/>
      <rect x="76" y="42" width="36" height="20" fill="url(#iR)"/>
      <path d="M64 24A12 12 0 0 1 76 36V62H64Z" fill="{{headerbar_bg_backdrop}}"/>
      <path d="M64 23V24A12 12 0 0 1 76 36V62H77V36A13 13 0 0 0 64 23Z" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <g id="decoration-inactive-left">
      <rect x="0" y="62" width="36" height="10" fill="url(#iL)"/>
      <rect x="0" y="72" width="48" height="6" fill="url(#iBL)"/>
      <rect x="36" y="62" width="12" height="16" fill="{{window_bg}}"/>
      <rect x="35" y="62" width="1" height="16" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <rect id="decoration-inactive-center" x="48" y="62" width="16" height="16" fill="{{window_bg}}"/>
    <g id="decoration-inactive-right">
      <rect x="76" y="62" width="36" height="10" fill="url(#iR)"/>
      <rect x="64" y="72" width="48" height="6" fill="url(#iBR)"/>
      <rect x="64" y="62" width="12" height="16" fill="{{window_bg}}"/>
      <rect x="76" y="62" width="1" height="16" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <g id="decoration-inactive-bottomleft">
      <rect x="0" y="78" width="48" height="48" fill="url(#iBL)"/>
      <rect x="35" y="78" width="13" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <g id="decoration-inactive-bottom">
      <rect x="48" y="78" width="16" height="48" fill="url(#iB)"/>
      <rect x="48" y="78" width="16" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <g id="decoration-inactive-bottomright">
      <rect x="64" y="78" width="48" height="48" fill="url(#iBR)"/>
      <rect x="64" y="78" width="13" height="1" fill="rgb({{border|rgb}})" fill-opacity="{{border|alpha}}"/>
    </g>
    <rect id="decoration-maximized-inactive-center" x="0" y="140" width="16" height="38" fill="{{headerbar_bg_backdrop}}"/>
  </g>
</svg>
