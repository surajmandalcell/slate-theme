<?xml version="1.0" encoding="UTF-8"?>
<!--
  Slate Aurorae decoration. Frame layout (px), must match __NAME__rc:
    padding L/R 32, top 24, bottom 40 (shadow area), title bar {{headerbar_height}}, borders 0.
  Corner elements are 12 px wider than the left/right padding so the {{radius_window}} top corners
  fit; the extra 12 px hide under the client. Shadow = gradient strips (gaussian profile,
  sigma 13 active / 11 inactive); the numbers follow window_shadow / window_shadow_backdrop.
  The set of elements at x 120.. is the inactive window (decoration-inactive-*).
-->
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="224" height="170" viewBox="0 0 224 170">
  <defs>
    <!-- active shadow profiles, outer edge (0) to window edge (1) -->
    <linearGradient id="aSide"><stop offset="0.00" stop-opacity="0.003"/><stop offset="0.17" stop-opacity="0.009"/><stop offset="0.33" stop-opacity="0.022"/><stop offset="0.50" stop-opacity="0.048"/><stop offset="0.67" stop-opacity="0.091"/><stop offset="0.83" stop-opacity="0.150"/><stop offset="1.00" stop-opacity="0.220"/></linearGradient>
    <linearGradient id="aTop"><stop offset="0.00" stop-opacity="0.005"/><stop offset="0.17" stop-opacity="0.010"/><stop offset="0.33" stop-opacity="0.020"/><stop offset="0.50" stop-opacity="0.037"/><stop offset="0.67" stop-opacity="0.062"/><stop offset="0.83" stop-opacity="0.097"/><stop offset="1.00" stop-opacity="0.142"/></linearGradient>
    <linearGradient id="aBot"><stop offset="0.00" stop-opacity="0.002"/><stop offset="0.17" stop-opacity="0.008"/><stop offset="0.33" stop-opacity="0.025"/><stop offset="0.50" stop-opacity="0.062"/><stop offset="0.67" stop-opacity="0.126"/><stop offset="0.83" stop-opacity="0.211"/><stop offset="1.00" stop-opacity="0.298"/></linearGradient>
    <linearGradient id="aRad"><stop offset="0.00" stop-opacity="0.220"/><stop offset="0.17" stop-opacity="0.150"/><stop offset="0.33" stop-opacity="0.091"/><stop offset="0.50" stop-opacity="0.048"/><stop offset="0.67" stop-opacity="0.022"/><stop offset="0.83" stop-opacity="0.009"/><stop offset="1.00" stop-opacity="0.003"/></linearGradient>
    <linearGradient id="iSide"><stop offset="0.00" stop-opacity="0.001"/><stop offset="0.17" stop-opacity="0.002"/><stop offset="0.33" stop-opacity="0.007"/><stop offset="0.50" stop-opacity="0.020"/><stop offset="0.67" stop-opacity="0.047"/><stop offset="0.83" stop-opacity="0.088"/><stop offset="1.00" stop-opacity="0.140"/></linearGradient>
    <linearGradient id="iTop"><stop offset="0.00" stop-opacity="0.001"/><stop offset="0.17" stop-opacity="0.003"/><stop offset="0.33" stop-opacity="0.006"/><stop offset="0.50" stop-opacity="0.014"/><stop offset="0.67" stop-opacity="0.028"/><stop offset="0.83" stop-opacity="0.051"/><stop offset="1.00" stop-opacity="0.082"/></linearGradient>
    <linearGradient id="iBot"><stop offset="0.00" stop-opacity="0.000"/><stop offset="0.17" stop-opacity="0.002"/><stop offset="0.33" stop-opacity="0.008"/><stop offset="0.50" stop-opacity="0.028"/><stop offset="0.67" stop-opacity="0.071"/><stop offset="0.83" stop-opacity="0.133"/><stop offset="1.00" stop-opacity="0.198"/></linearGradient>
    <linearGradient id="iRad"><stop offset="0.00" stop-opacity="0.140"/><stop offset="0.17" stop-opacity="0.088"/><stop offset="0.33" stop-opacity="0.047"/><stop offset="0.50" stop-opacity="0.020"/><stop offset="0.67" stop-opacity="0.007"/><stop offset="0.83" stop-opacity="0.002"/><stop offset="1.00" stop-opacity="0.001"/></linearGradient>

    <!-- active: left, right, top, bottom strips and four corners -->
    <linearGradient id="aL" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="32" y2="0" xlink:href="#aSide"/>
    <linearGradient id="aR" gradientUnits="userSpaceOnUse" x1="104" y1="0" x2="72" y2="0" xlink:href="#aSide"/>
    <linearGradient id="aT" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="24" xlink:href="#aTop"/>
    <linearGradient id="aB" gradientUnits="userSpaceOnUse" x1="0" y1="118" x2="0" y2="78" xlink:href="#aBot"/>
    <radialGradient id="aTL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(32 24) scale(32 24)" xlink:href="#aRad"/>
    <radialGradient id="aTR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(72 24) scale(32 24)" xlink:href="#aRad"/>
    <radialGradient id="aBL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(32 78) scale(32 40)" xlink:href="#aRad"/>
    <radialGradient id="aBR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(72 78) scale(32 40)" xlink:href="#aRad"/>
    <!-- inactive: same geometry in the shifted set (user space includes the group shift) -->
    <linearGradient id="iL" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="32" y2="0" xlink:href="#iSide"/>
    <linearGradient id="iR" gradientUnits="userSpaceOnUse" x1="104" y1="0" x2="72" y2="0" xlink:href="#iSide"/>
    <linearGradient id="iT" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="24" xlink:href="#iTop"/>
    <linearGradient id="iB" gradientUnits="userSpaceOnUse" x1="0" y1="118" x2="0" y2="78" xlink:href="#iBot"/>
    <radialGradient id="iTL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(32 24) scale(32 24)" xlink:href="#iRad"/>
    <radialGradient id="iTR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(72 24) scale(32 24)" xlink:href="#iRad"/>
    <radialGradient id="iBL" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(32 78) scale(32 40)" xlink:href="#iRad"/>
    <radialGradient id="iBR" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" gradientTransform="translate(72 78) scale(32 40)" xlink:href="#iRad"/>
  </defs>

  <!-- ===== ACTIVE ===== -->
  <g id="decoration-topleft">
    <rect x="0" y="0" width="32" height="24" fill="url(#aTL)"/>
    <rect x="32" y="0" width="12" height="24" fill="url(#aT)"/>
    <rect x="0" y="24" width="32" height="38" fill="url(#aL)"/>
    <rect x="32" y="24" width="12" height="12" fill="#000" fill-opacity="0.14"/>
    <path d="M32 62V36A12 12 0 0 1 44 24V62Z" fill="{{headerbar_bg}}"/>
    <path d="M31 62V36A13 13 0 0 1 44 23V24A12 12 0 0 0 32 36V62Z" fill="#000" fill-opacity="0.3"/>
  </g>
  <g id="decoration-top">
    <rect x="44" y="0" width="16" height="24" fill="url(#aT)"/>
    <rect x="44" y="24" width="16" height="38" fill="{{headerbar_bg}}"/>
    <rect x="44" y="23" width="16" height="1" fill="#000" fill-opacity="0.3"/>
  </g>
  <g id="decoration-topright">
    <rect x="72" y="0" width="32" height="24" fill="url(#aTR)"/>
    <rect x="60" y="0" width="12" height="24" fill="url(#aT)"/>
    <rect x="72" y="24" width="32" height="38" fill="url(#aR)"/>
    <rect x="60" y="24" width="12" height="12" fill="#000" fill-opacity="0.14"/>
    <path d="M60 24A12 12 0 0 1 72 36V62H60Z" fill="{{headerbar_bg}}"/>
    <path d="M60 23V24A12 12 0 0 1 72 36V62H73V36A13 13 0 0 0 60 23Z" fill="#000" fill-opacity="0.3"/>
  </g>
  <g id="decoration-left">
    <rect x="0" y="62" width="32" height="16" fill="url(#aL)"/>
    <rect x="32" y="62" width="12" height="16" fill="{{window_bg}}"/>
    <rect x="31" y="62" width="1" height="16" fill="#000" fill-opacity="0.3"/>
  </g>
  <rect id="decoration-center" x="44" y="62" width="16" height="16" fill="{{window_bg}}"/>
  <g id="decoration-right">
    <rect x="60" y="62" width="12" height="16" fill="{{window_bg}}"/>
    <rect x="72" y="62" width="32" height="16" fill="url(#aR)"/>
    <rect x="72" y="62" width="1" height="16" fill="#000" fill-opacity="0.3"/>
  </g>
  <g id="decoration-bottomleft">
    <rect x="0" y="78" width="32" height="40" fill="url(#aBL)"/>
    <rect x="32" y="78" width="12" height="40" fill="url(#aB)"/>
    <rect x="31" y="78" width="13" height="1" fill="#000" fill-opacity="0.3"/>
  </g>
  <g id="decoration-bottom">
    <rect x="44" y="78" width="16" height="40" fill="url(#aB)"/>
    <rect x="44" y="78" width="16" height="1" fill="#000" fill-opacity="0.3"/>
  </g>
  <g id="decoration-bottomright">
    <rect x="72" y="78" width="32" height="40" fill="url(#aBR)"/>
    <rect x="60" y="78" width="12" height="40" fill="url(#aB)"/>
    <rect x="60" y="78" width="13" height="1" fill="#000" fill-opacity="0.3"/>
  </g>
  <rect id="decoration-maximized-center" x="0" y="130" width="16" height="38" fill="{{headerbar_bg}}"/>

  <!-- ===== INACTIVE (shifted 120 px right) ===== -->
  <g transform="translate(120 0)">
    <g id="decoration-inactive-topleft">
      <rect x="0" y="0" width="32" height="24" fill="url(#iTL)"/>
      <rect x="32" y="0" width="12" height="24" fill="url(#iT)"/>
      <rect x="0" y="24" width="32" height="38" fill="url(#iL)"/>
      <rect x="32" y="24" width="12" height="12" fill="#000" fill-opacity="0.09"/>
      <path d="M32 62V36A12 12 0 0 1 44 24V62Z" fill="{{headerbar_bg_backdrop}}"/>
      <path d="M31 62V36A13 13 0 0 1 44 23V24A12 12 0 0 0 32 36V62Z" fill="#000" fill-opacity="0.2"/>
    </g>
    <g id="decoration-inactive-top">
      <rect x="44" y="0" width="16" height="24" fill="url(#iT)"/>
      <rect x="44" y="24" width="16" height="38" fill="{{headerbar_bg_backdrop}}"/>
      <rect x="44" y="23" width="16" height="1" fill="#000" fill-opacity="0.2"/>
    </g>
    <g id="decoration-inactive-topright">
      <rect x="72" y="0" width="32" height="24" fill="url(#iTR)"/>
      <rect x="60" y="0" width="12" height="24" fill="url(#iT)"/>
      <rect x="72" y="24" width="32" height="38" fill="url(#iR)"/>
      <rect x="60" y="24" width="12" height="12" fill="#000" fill-opacity="0.09"/>
      <path d="M60 24A12 12 0 0 1 72 36V62H60Z" fill="{{headerbar_bg_backdrop}}"/>
      <path d="M60 23V24A12 12 0 0 1 72 36V62H73V36A13 13 0 0 0 60 23Z" fill="#000" fill-opacity="0.2"/>
    </g>
    <g id="decoration-inactive-left">
      <rect x="0" y="62" width="32" height="16" fill="url(#iL)"/>
      <rect x="32" y="62" width="12" height="16" fill="{{window_bg}}"/>
      <rect x="31" y="62" width="1" height="16" fill="#000" fill-opacity="0.2"/>
    </g>
    <rect id="decoration-inactive-center" x="44" y="62" width="16" height="16" fill="{{window_bg}}"/>
    <g id="decoration-inactive-right">
      <rect x="60" y="62" width="12" height="16" fill="{{window_bg}}"/>
      <rect x="72" y="62" width="32" height="16" fill="url(#iR)"/>
      <rect x="72" y="62" width="1" height="16" fill="#000" fill-opacity="0.2"/>
    </g>
    <g id="decoration-inactive-bottomleft">
      <rect x="0" y="78" width="32" height="40" fill="url(#iBL)"/>
      <rect x="32" y="78" width="12" height="40" fill="url(#iB)"/>
      <rect x="31" y="78" width="13" height="1" fill="#000" fill-opacity="0.2"/>
    </g>
    <g id="decoration-inactive-bottom">
      <rect x="44" y="78" width="16" height="40" fill="url(#iB)"/>
      <rect x="44" y="78" width="16" height="1" fill="#000" fill-opacity="0.2"/>
    </g>
    <g id="decoration-inactive-bottomright">
      <rect x="72" y="78" width="32" height="40" fill="url(#iBR)"/>
      <rect x="60" y="78" width="12" height="40" fill="url(#iB)"/>
      <rect x="60" y="78" width="13" height="1" fill="#000" fill-opacity="0.2"/>
    </g>
    <rect id="decoration-maximized-inactive-center" x="0" y="130" width="16" height="38" fill="{{headerbar_bg_backdrop}}"/>
  </g>
</svg>
