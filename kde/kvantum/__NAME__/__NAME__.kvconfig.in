[%General]
author=Slate
comment=Slate, a compact modern-macOS style ({{mode}})
x11drag=menubar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing={{spacing_xs|px}}
toolbar_interior_spacing={{spacing_xs|px}}
spread_progressbar=true
progressbar_thickness={{progress_height|px}}
textless_progressbar=false
composite=true
translucent_windows=false
blurring=false
popup_blurring=true
reduce_window_opacity=0
reduce_menu_opacity=6
menu_shadow_depth=12
tooltip_shadow_depth=8
spread_menuitems=true
submenu_overlap=0
submenu_delay=250
tooltip_delay=500
splitter_width={{spacing_xs|px}}
; scroll_width = scrollbar_thumb_hover 8 + 2 x scrollbar_margin 2 (no arithmetic in templates)
scroll_width=12
scroll_min_extent={{scrollbar_min_length|px}}
scroll_arrows=false
transient_scrollbar=true
transient_groove=true
combo_as_lineedit=false
combo_menu=true
combo_focus_rect=false
inline_spin_indicators=true
vertical_spin_indicators=false
slider_width={{slider_track|px}}
; handle tile = knob 16 centered in control_height 24 (gen-kvantum-svg.py), so the slider is 24 high like GTK4 scale
slider_handle_width={{control_height|px}}
slider_handle_length={{slider_knob|px}}
check_size={{check_size|px}}
small_icon_size={{icon_size|px}}
large_icon_size={{icon_size_large|px}}
button_icon_size={{icon_size|px}}
toolbar_icon_size={{icon_size|px}}
layout_spacing={{spacing_m|px}}
layout_margin={{spacing_l|px}}
button_contents_shift=false
tree_branch_line=false
respect_DE=true
; motion (specs/motion.md): Kvantum fades hover, press and focus with one fixed built-in timing;
; menu and tooltip fades come from KWin fadingpopups (scripts/apply-kde.sh)
animate_states=true
no_window_pattern=true
fill_rubberband=true
merge_menubar_with_toolbar=true
scrollable_menu=true
dialog_button_layout=0
click_behavior=0
iconless_menu=false
; Kvantum adds 5 px to this value: total separator 9 = 1 + 4 + 4
menu_separator_height=4
center_doc_tabs=true

[GeneralColors]
window.color={{window_bg}}
base.color={{view_bg}}
alt.base.color={{sidebar_bg}}
button.color={{button_bg}}
light.color=#00000000
mid.light.color={{button_bg}}
dark.color={{border_hex}}
mid.color=#00000000
highlight.color={{selection_bg}}
inactive.highlight.color={{selection_bg_backdrop}}
inactive.highlight.text.color={{fg}}
inactive.text.color={{fg}}
inactive.window.text.color={{fg}}
text.color={{fg}}
window.text.color={{fg}}
button.text.color={{fg}}
disabled.text.color={{fg_disabled}}
tooltip.base.color={{tooltip_bg}}
tooltip.text.color={{tooltip_fg}}
highlight.text.color={{selection_fg}}
link.color={{accent}}
link.visited.color={{fg_secondary}}

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
transparent_pcmanfm_view=false
blur_translucent=false
respect_darkness=true
kcapacitybar_as_progressbar=true
middle_click_scroll=false
scroll_jump_workaround=true
single_top_toolbar=true
iconless_pushbutton=false
normal_default_pushbutton=true
transparent_menutitle=true
no_selection_tint=true
tint_on_mouseover=0
disabled_icon_opacity=70
centered_forms=false
lxqtmainmenu_iconsize={{icon_size|px}}

; Padding = frame + text.margin. Text button: frame 6 + margin 6 = 12 (spacing_l).
[PanelButtonCommand]
frame=true
frame.element=button
frame.top={{spacing_2xs|px}}
frame.bottom={{spacing_2xs|px}}
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}
frame.expansion=12
interior=true
interior.element=button
indicator.size=12
indicator.element=arrow
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{fg}}
text.shadow=0
text.margin=0
text.iconspacing={{spacing_xs|px}}
text.margin.left=6
text.margin.right=6
min_height={{control_height|px}}

; Icon button 24 x 24: frame 4 + icon 16 + frame 4. Corners stay 6 through frame.expansion (expand-tbutton-normal marker).
[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
frame.top={{spacing_xs|px}}
frame.bottom={{spacing_xs|px}}
frame.left={{spacing_xs|px}}
frame.right={{spacing_xs|px}}
frame.expansion=12
text.margin.left=0
text.margin.right=0
min_height=0

[Dock]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=dock
interior.element=dock
frame.top={{radius_control|px}}
frame.bottom={{radius_control|px}}
frame.expansion=0
min_height=0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.focus.color={{fg}}
text.bold=true
min_height=0

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=12
text.margin.left=0
text.margin.right=0
min_height=0

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin=0
text.margin.left={{spacing_xs|px}}
min_height={{control_height|px}}

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin=0
text.margin.left={{spacing_xs|px}}
min_height={{control_height|px}}

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top={{radius_control|px}}
frame.bottom={{radius_control|px}}
frame.expansion=0
min_height=0

; Entry padding 8 = frame 6 + margin 2.
[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=2
text.margin.right=2
text.press.color={{fg}}
min_height={{control_height|px}}

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow

[IndicatorArrow]
indicator.element=arrow
indicator.size=12

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{fg}}
text.bold=true
text.margin.left=2

; Tab 24 high = track; the 20 px segment (radius_inner 4) is inset 2 inside the tile. Padding 12 = frame 6 + margin 6.
[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
indicator.element=tab
frame.top={{spacing_2xs|px}}
frame.bottom={{spacing_2xs|px}}
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}
frame.expansion=12
text.margin.left=6
text.margin.right=6
text.press.color={{accent_fg}}
text.toggle.color={{accent_fg}}
min_height={{control_height|px}}

[TabFrame]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=tabframe
interior.element=tabframe
frame.top={{radius_control|px}}
frame.bottom={{radius_control|px}}
frame.expansion=0
min_height=0

[TabBarFrame]
inherits=GenericFrame
frame=true
interior=true
frame.element=tabbar
interior.element=tabbar
frame.top={{spacing_2xs|px}}
frame.bottom={{spacing_2xs|px}}
frame.left={{spacing_2xs|px}}
frame.right={{spacing_2xs|px}}
frame.expansion=12
text.shadow=0

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9
min_height=0

[HeaderSection]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=header
text.margin.top=0
text.margin.bottom=0
text.margin.left={{spacing_m|px}}
text.margin.right={{spacing_m|px}}
min_height={{row_height|px}}

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13
min_height=0

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=toolbar
frame.element=toolbar
indicator.element=toolbar
indicator.size=5
text.margin=0
min_height=0

; Track 4 = frame 2 + 2.
[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0
min_height=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
min_height=0

; Bar 6 = frame 3 + 3.
[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
text.margin=0
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{fg}}
min_height=0

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
min_height=0

; Row padding 8 = frame 6 + margin 2; row height 24 comes from frame.expansion keeping the vertical frame at 2.
[ItemView]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}
frame.expansion=12
text.margin=0
text.margin.left=2
text.margin.right=2
min_height={{row_height|px}}
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{selection_fg}}
text.toggle.color={{selection_fg}}
text.normal.inactive.color={{fg}}
text.focus.inactive.color={{fg}}
text.press.inactive.color={{fg}}
text.toggle.inactive.color={{fg}}

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
frame.top=0
frame.bottom=0
frame.left=1
frame.right=1
indicator.element=splitter-grip
indicator.size=16
min_height=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9
min_height=0

; Thumb tile 6 with a 2 px transparent inset: 8 px pill, 12 px total.
[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=0
indicator.element=grip
indicator.size=0
min_height=0

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
min_height=0

; Item 24 high, padding 8 = frame 6 + margin 2, radius 6 (radius_menu_item).
[MenuItem]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.normal.color={{fg}}
text.focus.color={{accent_fg}}
text.press.color={{accent_fg}}
text.toggle.color={{accent_fg}}
text.margin=0
text.margin.left=2
text.margin.right=2
frame.top=0
frame.bottom=0
frame.left={{radius_menu_item|px}}
frame.right={{radius_menu_item|px}}
frame.expansion=12
min_height={{menu_item_height|px}}

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=menubar
frame.element=menubar
min_height=0

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
frame.element=menubaritem
frame.top=2
frame.bottom=2
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}
frame.expansion=12
text.margin=0
text.margin.left=2
text.margin.right=2
text.focus.color={{accent_fg}}
text.press.color={{accent_fg}}
text.toggle.color={{accent_fg}}
min_height={{control_height|px}}

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
indicator.element=mdi
text.normal.color={{fg_backdrop}}
text.focus.color={{fg}}
text.bold=true
min_height=0

; Padding left 8 = frame 6 + 2, right 6; arrow 12.
[ComboBox]
inherits=PanelButtonCommand
indicator.element=combo-arrow
indicator.size=12
text.margin.left=2
text.margin.right=0

; Menu padding = corner radius = 6. Kvantum forces frame.expansion to 0 for menus (Kvantum.cpp PE_PanelMenu), so
; radius 10 with padding 4 is not reachable; the corner tile is scaled into the frame size.
[Menu]
inherits=PanelButtonCommand
frame=true
interior=true
frame.top={{radius_control|px}}
frame.bottom={{radius_control|px}}
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}
frame.expansion=0
frame.element=menu
interior.element=menu
text.normal.color={{fg}}
min_height=0

[GroupBox]
inherits=GenericFrame
frame=true
interior=true
frame.element=group
interior.element=group
frame.top={{radius_control|px}}
frame.bottom={{radius_control|px}}
text.shadow=0
text.margin=0

; Tooltip padding 4 x 8 = frame 4 + margin 4 horizontally; radius 6 through frame.expansion.
[ToolTip]
inherits=GenericFrame
frame=true
interior=true
frame.top={{spacing_xs|px}}
frame.bottom={{spacing_xs|px}}
frame.left={{spacing_xs|px}}
frame.right={{spacing_xs|px}}
frame.expansion=12
text.shadow=0
text.margin=0
text.margin.left={{spacing_xs|px}}
text.margin.right={{spacing_xs|px}}
text.normal.color={{tooltip_fg}}
interior.element=tooltip
frame.element=tooltip

[StatusBar]
inherits=GenericFrame
frame=false
interior=false
text.normal.color={{fg_secondary}}

[Window]
interior=false

[Dialog]
interior=false
