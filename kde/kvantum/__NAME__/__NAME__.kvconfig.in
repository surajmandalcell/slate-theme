[%General]
author=Slate
comment=Slate, a compact modern-macOS style ({{mode}})
x11drag=menubar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=2
spread_progressbar=true
progressbar_thickness=5
textless_progressbar=false
composite=true
translucent_windows=false
blurring=false
popup_blurring=true
reduce_window_opacity=0
reduce_menu_opacity=6
menu_shadow_depth=12
tooltip_shadow_depth=8
spread_menuitems=true
submenu_overlap=0
submenu_delay=250
tooltip_delay=500
splitter_width=7
scroll_width=8
scroll_min_extent=36
scroll_arrows=false
transient_scrollbar=true
transient_groove=true
combo_as_lineedit=false
combo_menu=true
combo_focus_rect=false
inline_spin_indicators=true
vertical_spin_indicators=false
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=14
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
layout_spacing=6
layout_margin=8
button_contents_shift=false
tree_branch_line=false
respect_DE=true
animate_states=true
no_window_pattern=true
fill_rubberband=true
merge_menubar_with_toolbar=true
scrollable_menu=true
dialog_button_layout=0
click_behavior=0
iconless_menu=false
menu_separator_height=5
center_doc_tabs=true

[GeneralColors]
window.color={{window_bg}}
base.color={{view_bg}}
alt.base.color={{sidebar_bg}}
button.color={{button_bg}}
light.color=#00000000
mid.light.color={{button_bg}}
dark.color={{border_hex}}
mid.color=#00000000
highlight.color={{selection_bg}}
inactive.highlight.color={{selection_bg_backdrop}}
inactive.highlight.text.color={{fg}}
inactive.text.color={{fg}}
inactive.window.text.color={{fg}}
text.color={{fg}}
window.text.color={{fg}}
button.text.color={{fg}}
disabled.text.color={{fg_disabled}}
tooltip.base.color={{tooltip_bg}}
tooltip.text.color={{tooltip_fg}}
highlight.text.color={{selection_fg}}
link.color={{accent}}
link.visited.color={{fg_secondary}}

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
transparent_pcmanfm_view=false
blur_translucent=false
respect_darkness=true
kcapacitybar_as_progressbar=true
middle_click_scroll=false
scroll_jump_workaround=true
single_top_toolbar=true
iconless_pushbutton=false
normal_default_pushbutton=false
transparent_menutitle=true
no_selection_tint=true
tint_on_mouseover=0
disabled_icon_opacity=70
centered_forms=false
lxqtmainmenu_iconsize=16

[PanelButtonCommand]
frame=true
frame.element=button
frame.top={{radius_control|px}}
frame.bottom=7
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}
interior=true
interior.element=button
indicator.size=9
indicator.element=arrow
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{fg}}
text.shadow=0
text.margin=1
text.iconspacing=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
min_height={{control_height|px}}

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
frame.bottom={{radius_control|px}}
text.margin.left=3
text.margin.right=3
min_height=0

[Dock]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=dock
interior.element=dock
frame.bottom={{radius_control|px}}
min_height=0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.focus.color={{fg}}
text.bold=true
min_height=0

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=9
text.margin.left=0
text.margin.right=0
min_height=0

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin=0
min_height=0

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin=0
min_height=0

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
min_height=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.bottom={{radius_control|px}}
text.margin.left=2
text.margin.right=2
text.press.color={{fg}}
min_height={{control_height|px}}

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{fg}}
text.bold=true
text.margin.left=2

[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
indicator.element=tab
frame.bottom={{radius_control|px}}
text.margin.left=10
text.margin.right=10
text.margin.top=2
text.margin.bottom=2
text.press.color={{accent_fg}}
text.toggle.color={{accent_fg}}
min_height={{control_height|px}}

[TabFrame]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=tabframe
interior.element=tabframe
frame.bottom={{radius_control|px}}
min_height=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false
text.shadow=0

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9
min_height=0

[HeaderSection]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=header
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
min_height=0

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13
min_height=0

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=toolbar
frame.element=toolbar
indicator.element=toolbar
indicator.size=5
text.margin=0
min_height=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
min_height=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
min_height=0

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{fg}}
min_height=0

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
min_height=0

[ItemView]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=itemview
interior.element=itemview
frame.top={{radius_menu_item|px}}
frame.bottom={{radius_menu_item|px}}
frame.left={{radius_menu_item|px}}
frame.right={{radius_menu_item|px}}
text.margin=0
text.margin.top=0
text.margin.bottom=0
text.margin.left=1
text.margin.right=1
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{selection_fg}}
text.toggle.color={{selection_fg}}
text.normal.inactive.color={{fg}}
text.focus.inactive.color={{fg}}
text.press.inactive.color={{fg}}
text.toggle.inactive.color={{fg}}
min_height=0

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
frame.top=0
frame.bottom=0
frame.left=1
frame.right=1
indicator.element=splitter-grip
indicator.size=16
min_height=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9
min_height=0

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.element=grip
indicator.size=0
min_height=0

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
min_height=0

[MenuItem]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.normal.color={{fg}}
text.focus.color={{accent_fg}}
text.press.color={{accent_fg}}
text.toggle.color={{accent_fg}}
text.margin.top=1
text.margin.bottom=1
text.margin.left=6
text.margin.right=6
frame.top={{radius_menu_item|px}}
frame.bottom={{radius_menu_item|px}}
frame.left={{radius_menu_item|px}}
frame.right={{radius_menu_item|px}}
min_height={{menu_item_height|px}}

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=menubar
frame.element=menubar
min_height=0

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
frame.element=menubaritem
frame.top={{radius_menu_item|px}}
frame.bottom={{radius_menu_item|px}}
frame.left={{radius_menu_item|px}}
frame.right={{radius_menu_item|px}}
text.margin.left=4
text.margin.right=4
text.focus.color={{accent_fg}}
text.press.color={{accent_fg}}
text.toggle.color={{accent_fg}}
min_height=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
indicator.element=mdi
text.normal.color={{fg_backdrop}}
text.focus.color={{fg}}
text.bold=true
min_height=0

[ComboBox]
inherits=PanelButtonCommand
indicator.element=combo-arrow
indicator.size=9
text.margin.right=2

[Menu]
inherits=PanelButtonCommand
frame=true
interior=true
frame.top={{radius_menu_item|px}}
frame.bottom={{radius_menu_item|px}}
frame.left={{radius_menu_item|px}}
frame.right={{radius_menu_item|px}}
frame.element=menu
interior.element=menu
text.normal.color={{fg}}
min_height=0

[GroupBox]
inherits=GenericFrame
frame=true
interior=true
frame.element=group
interior.element=group
text.shadow=0
text.margin=0
frame.top={{radius_control|px}}
frame.bottom={{radius_control|px}}
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}

[ToolTip]
inherits=GenericFrame
frame=true
interior=true
frame.top={{radius_control|px}}
frame.bottom={{radius_control|px}}
frame.left={{radius_control|px}}
frame.right={{radius_control|px}}
text.shadow=0
text.margin=0
text.normal.color={{tooltip_fg}}
interior.element=tooltip
frame.element=tooltip

[StatusBar]
inherits=GenericFrame
frame=false
interior=false
text.normal.color={{fg_secondary}}

[Window]
interior=false

[Dialog]
interior=false
