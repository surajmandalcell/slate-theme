<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.0" width="560" height="112">
<!-- Slate Kvantum sheet. Corner radii are LITERAL in the path arcs and must be redrawn if the tokens change: 6 = radius_control (button, lineedit, tab, tabframe, group, dock, tooltip), 5 = radius_menu_item (menu, menuitem, menubaritem, itemview; the menu corner piece cannot be 10 because Kvantum scales it into the frame size, which must stay about 5 for tight padding; radius_popover=10 is not reachable), 4 = scrollbar pills and common frames, 3 = progress/slider tracks. Checkbox rx uses the radius_check token. Each assembled widget = 8 frame pieces + interior. -->
<!-- Opacity of flat_hover, flat_active, scrollbar and accent_soft comes from the alpha token filter. -->
<rect width="560" height="112" fill="{{window_bg}}"/>
<g id="button-normal-topleft" transform="translate(8,8)"><rect width="6" height="6" opacity="0"/><path d="M0 6A6 6 0 0 1 6 0V6Z" fill="{{button_bg}}"/><path d="M0 6A6 6 0 0 1 6 0V1A5 5 0 0 0 1 6Z" fill="{{border_hex}}"/></g>
<g id="button-normal-topright" transform="translate(18,8)"><rect width="6" height="6" opacity="0"/><path d="M0 0A6 6 0 0 1 6 6H0Z" fill="{{button_bg}}"/><path d="M0 0A6 6 0 0 1 6 6H5A5 5 0 0 0 0 1Z" fill="{{border_hex}}"/></g>
<g id="button-normal-bottomleft" transform="translate(8,18)"><rect width="6" height="7" opacity="0"/><path d="M0 1A6 6 0 0 0 6 7V1Z" fill="#000" fill-opacity="0.16"/><path d="M0 0A6 6 0 0 0 6 6V0Z" fill="{{button_bg}}"/><path d="M0 0A6 6 0 0 0 6 6V5A5 5 0 0 1 1 0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-bottomright" transform="translate(18,18)"><rect width="6" height="7" opacity="0"/><path d="M6 1A6 6 0 0 1 0 7V1Z" fill="#000" fill-opacity="0.16"/><path d="M6 0A6 6 0 0 1 0 6V0Z" fill="{{button_bg}}"/><path d="M6 0A6 6 0 0 1 0 6V5A5 5 0 0 0 5 0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-top" transform="translate(14,8)"><rect width="4" height="6" opacity="0"/><path d="M0 0H4V6H0Z" fill="{{button_bg}}"/><path d="M0 0H4V1H0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-bottom" transform="translate(14,18)"><rect width="4" height="7" opacity="0"/><path d="M0 1H4V7H0Z" fill="#000" fill-opacity="0.16"/><path d="M0 0H4V6H0Z" fill="{{button_bg}}"/><path d="M0 5H4V6H0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-left" transform="translate(8,14)"><rect width="6" height="4" opacity="0"/><path d="M0 0H6V4H0Z" fill="{{button_bg}}"/><path d="M0 0H1V4H0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-right" transform="translate(18,14)"><rect width="6" height="4" opacity="0"/><path d="M0 0H6V4H0Z" fill="{{button_bg}}"/><path d="M5 0H6V4H5Z" fill="{{border_hex}}"/></g>
<rect id="button-normal" x="14" y="14" width="4" height="4" fill="{{button_bg}}"/>
<g id="button-focused-topleft" transform="translate(32,8)"><rect width="6" height="6" opacity="0"/><path d="M0 6A6 6 0 0 1 6 0V6Z" fill="{{button_bg_hover}}"/><path d="M0 6A6 6 0 0 1 6 0V1A5 5 0 0 0 1 6Z" fill="{{border_hex}}"/></g>
