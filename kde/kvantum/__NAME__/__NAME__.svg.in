<!-- default button: Kvantum cannot color default-button text, so the default style is a subtle accent tint (accent_soft) over the normal button with an accent border; the normal fg text stays readable -->
<g id="button-default-topleft" transform="translate(104,8)"><rect width="6" height="6" opacity="0"/><path d="M0 6A6 6 0 0 1 6 0V6Z" fill="rgb({{accent|rgb}})" fill-opacity="{{accent_soft|alpha}}"/><path d="M0 6A6 6 0 0 1 6 0V1A5 5 0 0 0 1 6Z" fill="{{accent}}"/></g>
