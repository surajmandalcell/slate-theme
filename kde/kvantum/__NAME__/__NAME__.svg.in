<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.0" width="640" height="104">
<!-- Slate Kvantum sheet. Corner radii are LITERAL in the path arcs and must be redrawn if the tokens change: 6 = radius_control and radius_menu_item (button, tbutton, lineedit, tabbar, tabframe, group, common, dock, tooltip, menuitem, menubaritem, itemview), (menu is 6 too: Kvantum scales the menu corner tile into the frame size and forces frame.expansion to 0 for menus, so radius_popover 10 is not reachable), 4 = radius_inner (tab segments; scrollbar thumb pill), 3 = progress_height / 2, 2 = slider_track / 2. Scrollbar tiles are 6 with a 2 px inset = scrollbar_margin (thumb 8 = scrollbar_thumb_hover). Checkbox rx uses the radius_check token; check and knob are drawn at check_size / slider_knob (16). Each assembled widget = 8 frame pieces + interior; expand-* are empty markers for Kvantum frame.expansion. -->
<!-- Opacity of flat_hover, flat_active, scrollbar and accent_soft comes from the alpha token filter. Default button: Kvantum cannot color default-button text, so it is an accent tint over the normal button. -->
<rect width="640" height="104" fill="{{window_bg}}"/>
<g id="button-normal-topleft" transform="translate(8,8)"><path d="M0 6A6 6 0 0 1 6 0V6Z" fill="{{button_bg}}"/><path d="M0 6A6 6 0 0 1 6 0V1A5 5 0 0 0 1 6Z" fill="{{border_hex}}"/></g>
<g id="button-normal-topright" transform="translate(18,8)"><path d="M0 0A6 6 0 0 1 6 6H0Z" fill="{{button_bg}}"/><path d="M0 0A6 6 0 0 1 6 6H5A5 5 0 0 0 0 1Z" fill="{{border_hex}}"/></g>
<g id="button-normal-bottomleft" transform="translate(8,18)"><path d="M0 0A6 6 0 0 0 6 6V0Z" fill="{{button_bg}}"/><path d="M0 0A6 6 0 0 0 6 6V5A5 5 0 0 1 1 0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-bottomright" transform="translate(18,18)"><path d="M6 0A6 6 0 0 1 0 6V0Z" fill="{{button_bg}}"/><path d="M6 0A6 6 0 0 1 0 6V5A5 5 0 0 0 5 0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-top" transform="translate(14,8)"><path d="M0 0H4V6H0Z" fill="{{button_bg}}"/><path d="M0 0H4V1H0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-bottom" transform="translate(14,18)"><path d="M0 0H4V6H0Z" fill="{{button_bg}}"/><path d="M0 5H4V6H0Z" fill="{{border_hex}}"/><path d="M0 5H4V6H0Z" fill="#000" fill-opacity="0.10"/></g>
<g id="button-normal-left" transform="translate(8,14)"><path d="M0 0H6V4H0Z" fill="{{button_bg}}"/><path d="M0 0H1V4H0Z" fill="{{border_hex}}"/></g>
<g id="button-normal-right" transform="translate(18,14)"><path d="M0 0H6V4H0Z" fill="{{button_bg}}"/><path d="M5 0H6V4H5Z" fill="{{border_hex}}"/></g>
<rect id="button-normal" x="14" y="14" width="4" height="4" fill="{{button_bg}}"/>
<rect id="expand-button-normal" x="8" y="8" width="1" height="1" opacity="0"/>
<g id="button-focused-topleft" transform="translate(32,8)"><path d="M0 6A6 6 0 0 1 6 0V6Z" fill="{{button_bg_hover}}"/><path d="M0 6A6 6 0 0 1 6 0V1A5 5 0 0 0 1 6Z" fill="{{border_hex}}"/></g>
<g id="button-focused-topright" transform="translate(42,8)"><path d="M0 0A6 6 0 0 1 6 6H0Z" fill="{{button_bg_hover}}"/><path d="M0 0A6 6 0 0 1 6 6H5A5 5 0 0 0 0 1Z" fill="{{border_hex}}"/></g>
<g id="button-focused-bottomleft" transform="translate(32,18)"><path d="M0 0A6 6 0 0 0 6 6V0Z" fill="{{button_bg_hover}}"/><path d="M0 0A6 6 0 0 0 6 6V5A5 5 0 0 1 1 0Z" fill="{{border_hex}}"/></g>
