<g transform="translate(326,88)"><g id="radio-checked-focused"><rect width="14" height="14" opacity="0"/><circle cx="7" cy="7" r="7" fill="{{accent_hover}}"/><circle cx="7" cy="7" r="2.5" fill="{{accent_fg}}"/></g></g>
<g transform="translate(348,88)"><g id="slidercursor-normal"><rect width="16" height="16" opacity="0"/><circle cx="8" cy="8.7" r="7" fill="#000" fill-opacity="0.18"/><circle cx="8" cy="8" r="7" fill="{{switch_knob_color}}" stroke="{{border_hex}}" stroke-width="0.6"/></g></g>
<g transform="translate(372,88)"><g id="slidercursor-focused"><rect width="16" height="16" opacity="0"/><circle cx="8" cy="8.7" r="7" fill="#000" fill-opacity="0.18"/><circle cx="8" cy="8" r="7" fill="{{switch_knob_color}}" stroke="{{border_hex}}" stroke-width="0.6"/></g></g>
<g transform="translate(396,88)"><g id="slidercursor-pressed"><rect width="16" height="16" opacity="0"/><circle cx="8" cy="8.7" r="7" fill="#000" fill-opacity="0.18"/><circle cx="8" cy="8" r="7" fill="{{switch_knob_color}}" stroke="{{border_hex}}" stroke-width="0.6"/></g></g>
<g transform="translate(420,88)"><g id="slidercursor-toggled"><rect width="16" height="16" opacity="0"/><circle cx="8" cy="8.7" r="7" fill="#000" fill-opacity="0.18"/><circle cx="8" cy="8" r="7" fill="{{switch_knob_color}}" stroke="{{border_hex}}" stroke-width="0.6"/></g></g>
<g transform="translate(444,88)"><g id="slidercursor-disabled" opacity="0.55"><rect width="16" height="16" opacity="0"/><circle cx="8" cy="8.7" r="7" fill="#000" fill-opacity="0.18"/><circle cx="8" cy="8" r="7" fill="{{switch_knob_color}}" stroke="{{border_hex}}" stroke-width="0.6"/></g></g>
<!-- tree expander glyphs and slider tick, so Kvantum's default theme never shows through -->
<g transform="translate(480,92)"><g id="arrow-minus-normal"><rect width="9" height="9" opacity="0"/><path d="M2 4.5H7" fill="none" stroke="{{fg}}" stroke-width="1.4" stroke-linecap="round"/></g></g>
<g transform="translate(494,92)"><g id="arrow-minus-pressed"><rect width="9" height="9" opacity="0"/><path d="M2 4.5H7" fill="none" stroke="{{fg}}" stroke-width="1.4" stroke-linecap="round"/></g></g>
<g transform="translate(508,92)"><g id="arrow-plus-normal"><rect width="9" height="9" opacity="0"/><path d="M2 4.5H7M4.5 2V7" fill="none" stroke="{{fg}}" stroke-width="1.4" stroke-linecap="round"/></g></g>
<g transform="translate(522,92)"><g id="arrow-plus-pressed"><rect width="9" height="9" opacity="0"/><path d="M2 4.5H7M4.5 2V7" fill="none" stroke="{{fg}}" stroke-width="1.4" stroke-linecap="round"/></g></g>
<rect id="slider-tick-normal" x="540" y="96" width="4" height="1" fill="{{fg_disabled}}"/>
