<?xml version="1.0" encoding="UTF-8"?>
<!-- Slate list item: solid accent hover/selection, radius_menu_item, {{spacing_xs}} side inset (the same as the GTK menu items). One row of tiles per prefix (hover y=0, selected y=30, selected+hover y=60, normal y=90); hints at x=50. -->
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="100" height="110" viewBox="0 0 100 110">
  <defs>
    <g id="c"><rect width="{{spacing_xs|px}}" height="8" fill-opacity="0"/><path transform="translate({{spacing_xs|px}} 0)" fill="{{accent}}" d="M 0,{{radius_menu_item|px}} A {{radius_menu_item|px}},{{radius_menu_item|px}} 0 0 1 {{radius_menu_item|px}},0 H 8 V 8 H 0 Z"/></g>
    <g id="l"><rect width="{{spacing_xs|px}}" height="1" fill-opacity="0"/><rect x="{{spacing_xs|px}}" width="8" height="1" fill="{{accent}}"/></g>
  </defs>

  <g id="hover-topleft" transform="translate(0 0)"><use xlink:href="#c"/></g>
  <g id="hover-topright" transform="matrix(-1 0 0 1 36 0)"><use xlink:href="#c"/></g>
  <g id="hover-bottomleft" transform="matrix(1 0 0 -1 0 20)"><use xlink:href="#c"/></g>
  <g id="hover-bottomright" transform="matrix(-1 0 0 -1 36 20)"><use xlink:href="#c"/></g>
  <g id="hover-left" transform="translate(0 10)"><use xlink:href="#l"/></g>
  <g id="hover-right" transform="matrix(-1 0 0 1 36 10)"><use xlink:href="#l"/></g>
  <rect id="hover-top" x="20" y="0" width="1" height="8" fill="{{accent}}"/>
  <rect id="hover-bottom" x="20" y="12" width="1" height="8" fill="{{accent}}"/>
  <rect id="hover-center" x="20" y="10" width="1" height="1" fill="{{accent}}"/>

  <g id="selected-topleft" transform="translate(0 30)"><use xlink:href="#c"/></g>
  <g id="selected-topright" transform="matrix(-1 0 0 1 36 30)"><use xlink:href="#c"/></g>
  <g id="selected-bottomleft" transform="matrix(1 0 0 -1 0 50)"><use xlink:href="#c"/></g>
  <g id="selected-bottomright" transform="matrix(-1 0 0 -1 36 50)"><use xlink:href="#c"/></g>
  <g id="selected-left" transform="translate(0 40)"><use xlink:href="#l"/></g>
  <g id="selected-right" transform="matrix(-1 0 0 1 36 40)"><use xlink:href="#l"/></g>
  <rect id="selected-top" x="20" y="30" width="1" height="8" fill="{{accent}}"/>
  <rect id="selected-bottom" x="20" y="42" width="1" height="8" fill="{{accent}}"/>
  <rect id="selected-center" x="20" y="40" width="1" height="1" fill="{{accent}}"/>

  <g id="selected+hover-topleft" transform="translate(0 60)"><use xlink:href="#c"/></g>
  <g id="selected+hover-topright" transform="matrix(-1 0 0 1 36 60)"><use xlink:href="#c"/></g>
  <g id="selected+hover-bottomleft" transform="matrix(1 0 0 -1 0 80)"><use xlink:href="#c"/></g>
  <g id="selected+hover-bottomright" transform="matrix(-1 0 0 -1 36 80)"><use xlink:href="#c"/></g>
  <g id="selected+hover-left" transform="translate(0 70)"><use xlink:href="#l"/></g>
  <g id="selected+hover-right" transform="matrix(-1 0 0 1 36 70)"><use xlink:href="#l"/></g>
  <rect id="selected+hover-top" x="20" y="60" width="1" height="8" fill="{{accent}}"/>
  <rect id="selected+hover-bottom" x="20" y="72" width="1" height="8" fill="{{accent}}"/>
  <rect id="selected+hover-center" x="20" y="70" width="1" height="1" fill="{{accent}}"/>

  <rect id="normal-center" x="20" y="100" width="1" height="1" fill-opacity="0"/>

  <rect id="hover-hint-top-margin" x="50" y="0" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="hover-hint-bottom-margin" x="60" y="0" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="hover-hint-left-margin" x="70" y="0" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
  <rect id="hover-hint-right-margin" x="70" y="6" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
  <rect id="selected-hint-top-margin" x="50" y="30" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="selected-hint-bottom-margin" x="60" y="30" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="selected-hint-left-margin" x="70" y="30" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
  <rect id="selected-hint-right-margin" x="70" y="36" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
  <rect id="selected+hover-hint-top-margin" x="50" y="60" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="selected+hover-hint-bottom-margin" x="60" y="60" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="selected+hover-hint-left-margin" x="70" y="60" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
  <rect id="selected+hover-hint-right-margin" x="70" y="66" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
  <rect id="normal-hint-top-margin" x="50" y="90" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="normal-hint-bottom-margin" x="60" y="90" width="4" height="{{spacing_xs|px}}" fill-opacity="0"/>
  <rect id="normal-hint-left-margin" x="70" y="90" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
  <rect id="normal-hint-right-margin" x="70" y="96" width="{{spacing_m|px}}" height="4" fill-opacity="0"/>
</svg>
