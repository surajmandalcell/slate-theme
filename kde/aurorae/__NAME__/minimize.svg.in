<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimize traffic light. Each 12x12 cell is one Aurorae state. -->
<svg xmlns="http://www.w3.org/2000/svg" width="12" height="60" viewBox="0 0 12 60">
  <g id="active-center">
    <rect x="0" y="0" width="12" height="12" fill="none"/>
    <circle cx="6" cy="6" r="5.75" fill="{{traffic_min}}" stroke="{{traffic_min_border}}" stroke-width="0.5"/>
  </g>
  <g id="hover-center">
    <rect x="0" y="12" width="12" height="12" fill="none"/>
    <circle cx="6" cy="18" r="5.75" fill="{{traffic_min}}" stroke="{{traffic_min_border}}" stroke-width="0.5"/>
    <path d="M3.4 18H8.6" stroke="{{traffic_glyph}}" stroke-width="1.1" stroke-linecap="round" fill="none"/>
  </g>
  <g id="pressed-center">
    <rect x="0" y="24" width="12" height="12" fill="none"/>
    <circle cx="6" cy="30" r="5.75" fill="{{traffic_min_border}}" stroke="{{traffic_min_border}}" stroke-width="0.5"/>
    <path d="M3.4 30H8.6" stroke="{{traffic_glyph}}" stroke-width="1.1" stroke-linecap="round" fill="none"/>
  </g>
  <g id="inactive-center">
    <rect x="0" y="36" width="12" height="12" fill="none"/>
    <circle cx="6" cy="42" r="5.75" fill="{{border_hex}}" stroke="{{fg_disabled}}" stroke-width="0.5"/>
  </g>
  <g id="deactivated-center">
    <rect x="0" y="48" width="12" height="12" fill="none"/>
    <circle cx="6" cy="54" r="5.75" fill="{{border_hex}}" stroke="{{fg_disabled}}" stroke-width="0.5"/>
  </g>
</svg>
