[General]
ActiveTextColor={{fg|rgb}}
InactiveTextColor={{fg_backdrop|rgb}}
Animation=150
UseTextShadow=false
Shadow=true
# Aurorae reads these two from [General] and accepts only left, center or right.
TitleAlignment=Center
TitleVerticalAlignment=Center

[Layout]
# Title bar {{headerbar_height}}; every border is 0 so the client touches the frame.
BorderLeft=0
BorderRight=0
BorderBottom=0
BorderTop={{headerbar_height|px}}
BorderLeftMaximized=0
BorderRightMaximized=0
BorderBottomMaximized=0
BorderTopMaximized={{headerbar_height|px}}

# Shadow area drawn by decoration.svg (see the comment there). Left/right/top/bottom.
PaddingLeft={{shadow_pad_side|px}}
PaddingRight={{shadow_pad_side|px}}
PaddingTop={{shadow_pad_top|px}}
PaddingBottom={{shadow_pad_bottom|px}}

TitleHeight={{headerbar_height|px}}
TitleEdgeTop=0
TitleEdgeBottom=0
TitleEdgeLeft={{traffic_margin|px}}
TitleEdgeRight=0
TitleEdgeTopMaximized=0
TitleEdgeBottomMaximized=0
TitleEdgeLeftMaximized={{traffic_margin|px}}
TitleEdgeRightMaximized=0
# Caption sits centered in the window: the left group is margin + 3 x size + 2 x gap
# ({{traffic_margin|px}} + 3 x {{traffic_size|px}} + 2 x {{traffic_gap|px}} = 64), so Left + 64 equals Right.
# No token holds the sum and templates cannot add, so Right stays typed; keep it in step with the tokens.
TitleBorderLeft={{spacing_m|px}}
TitleBorderRight=72

ButtonWidth={{traffic_size|px}}
ButtonHeight={{traffic_size|px}}
ButtonSpacing={{traffic_gap|px}}
# (headerbar_height - traffic_size) / 2 = ({{headerbar_height|px}} - {{traffic_size|px}}) / 2 = 14; no token holds the difference.
ButtonMarginTop=14
ButtonMarginTopMaximized=14
ExplicitButtonSpacer=0
